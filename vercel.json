{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "bun install --frozen-lockfile",
  "buildCommand": "bunx convex deploy --cmd 'bun run build'",
  "outputDirectory": "build/client",
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
